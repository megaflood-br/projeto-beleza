generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  tradeName           String?
  document            String?
  phone               String?
  email               String?
  address             String?
  city                String?
  timezone            String   @default("America/Sao_Paulo")
  plan                String   @default("profissional")
  status              String   @default("ACTIVE")
  isPlatform          Boolean  @default(false)
  notes               String?
  trialEndsAt         DateTime?
  accentColor         String   @default("#2563EB")
  openTime            String   @default("08:00")
  closeTime           String   @default("20:00")
  slotMinutes         Int      @default(15)
  openaiApiKey        String?
  contoraApiToken     String?
  publicAppUrl        String?
  evolutionUrl        String?
  evolutionApiKey     String?
  evolutionInstance   String?
  evolutionStatus     String?
  evolutionNumber     String?
  reminderHours       Int      @default(24)
  cashbackEnabled      Boolean  @default(false)
  cashbackEarnPct      Int      @default(5)
  cashbackUseItemPct   Boolean  @default(true)
  cashbackOnServices   Boolean  @default(true)
  cashbackOnProducts   Boolean  @default(true)
  cashbackMinSpendCents Int     @default(0)
  cashbackMaxRedeemPct Int      @default(100)
  cashbackExpireDays   Int      @default(0)
  cashbackCentsPerPoint Int     @default(100)
  fiscalEnabled         Boolean @default(false)
  fiscalCnpj            String?
  fiscalIe              String?
  fiscalIm              String?
  fiscalCrt             String  @default("1")
  fiscalUf              String  @default("SP")
  fiscalIbge            String?
  fiscalIssPct          Int     @default(5)
  fiscalServiceCode     String  @default("6.01")
  fiscalSeries          String  @default("1")
  fiscalNextNumber      Int     @default(1)
  fiscalProvider           String    @default("contora")
  fiscalProviderUrl        String?
  fiscalProviderToken      String?
  fiscalEnvironment        String    @default("homolog")
  fiscalAutoIssue          Boolean   @default(false)
  fiscalStreet             String?
  fiscalNumber             String?
  fiscalDistrict           String?
  fiscalZip                String?
  fiscalCscId              String?
  fiscalCscToken           String?
  fiscalContoraCompanyId   String?
  fiscalCertificateAt      DateTime?
  fiscalCertificateUntil   DateTime?
  kind                String   @default("SALON")
  deliveryMinCents    Int      @default(0)
  deliveryFeeCents    Int      @default(0)
  supplierPayMethods  String   @default("PIX,CASH")
  servedCities        String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users          User[]
  professionals  Professional[]
  clients        Client[]
  categories     ServiceCategory[]
  services       Service[]
  appointments   Appointment[]
  products           Product[]
  productCategories  ProductCategory[]
  productLots        ProductLot[]
  productRequests    ProductRequest[]
  stockMoves         StockMovement[]
  commissions    Commission[]
  transactions   Transaction[]
  packages       Package[]
  clientPackages ClientPackage[]
  conversations  Conversation[]
  automations    Automation[]
  campaignSends  CampaignSend[]
  comandas       Comanda[]
  financeAccounts    FinanceAccount[]
  paymentMethods     PaymentMethodConfig[]
  financeCategories  FinanceCategory[]
  anamnesisForms     AnamnesisForm[]
  anamneses          Anamnesis[]
  cashbackMoves      CashbackMovement[]
  supportTickets     SupportTicket[]
  supportCalls       SupportCall[]
  supportPresences   SupportPresence[]
  professionalGoals  ProfessionalGoal[]
  fiscalInvoices     FiscalInvoice[]
  promotions         Promotion[]
  catalogProducts    SupplierProduct[]
  supplierPromos     SupplierPromotion[]
  ordersAsSalon      SupplierOrder[] @relation("OrdersAsSalon")
  ordersAsSupplier   SupplierOrder[] @relation("OrdersAsSupplier")

  @@index([slug])
  @@index([kind])
}

model User {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String    @unique
  passwordHash   String
  name           String
  role           String
  active         Boolean   @default(true)
  professionalId String?   @unique
  professional   Professional? @relation(fields: [professionalId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ticketsCreated    SupportTicket[]  @relation("TicketAuthor")
  ticketsAssigned   SupportTicket[]  @relation("TicketAssignee")
  supportMessages   SupportMessage[]
  callsStarted      SupportCall[]    @relation("CallStarter")
  callsAccepted     SupportCall[]    @relation("CallAcceptor")
  supportPresence   SupportPresence?
  supplierOrders    SupplierOrder[]

  @@index([tenantId])
}

model Professional {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  nickname      String?
  color         String   @default("#2563EB")
  phone         String?
  specialty     String?
  commissionPct Int      @default(40)
  active        Boolean  @default(true)
  workStart     String   @default("09:00")
  workEnd       String   @default("19:00")
  imageUrl      String?
  birthDate     DateTime?
  document      String?
  rg            String?
  notes         String?
  zip           String?
  address       String?
  addressNumber String?
  complement    String?
  district      String?
  city          String?
  state         String?
  onlineBooking Boolean  @default(true)
  generateAgenda Boolean @default(true)
  receivesCommission Boolean @default(true)
  isStockist    Boolean  @default(false)
  salonPartner  Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User?
  appointments   Appointment[]
  appointmentItems AppointmentItem[]
  commissions    Commission[]
  serviceLinks   ProfessionalService[]
  comandas         Comanda[]
  comandaItems     ComandaItem[]
  transactions     Transaction[]
  productRequests  ProductRequest[]
  anamneses        Anamnesis[]
  goals            ProfessionalGoal[]

  @@index([tenantId])
}

model ProfessionalGoal {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  metric         String
  targetValue    Int
  startDate      String
  endDate        String
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, professionalId, metric, startDate, endDate])
  @@index([tenantId, startDate, endDate])
  @@index([professionalId])
}

model FiscalInvoice {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comandaId    String?
  comanda      Comanda?  @relation(fields: [comandaId], references: [id], onDelete: SetNull)
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  kind         String
  status       String    @default("DRAFT")
  number       Int?
  series       String?
  accessKey    String?
  protocol     String?
  environment  String    @default("homolog")
  provider     String    @default("local")
  providerRef  String?
  amountCents  Int
  taxCents     Int       @default(0)
  issuedAt     DateTime?
  cancelledAt  DateTime?
  errorMessage String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, issuedAt])
  @@index([tenantId, status])
  @@index([comandaId])
}

model Promotion {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  startsOn      DateTime
  endsOn        DateTime
  weekdays      String   @default("0,1,2,3,4,5,6")
  discountType  String   @default("PERCENT")
  discountValue Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         PromotionItem[]

  @@index([tenantId, active, startsOn, endsOn])
}

model PromotionItem {
  id          String     @id @default(cuid())
  promotionId String
  promotion   Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  type        String
  serviceId   String?
  service     Service?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0)
  services  Service[]

  @@index([tenantId])
}

model Service {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      ServiceCategory? @relation(fields: [categoryId], references: [id])
  name          String
  durationMin   Int
  priceCents    Int
  color         String   @default("#6366F1")
  commissionPct Int?
  active        Boolean  @default(true)
  favorite      Boolean  @default(false)
  extraCostCents Int     @default(0)
  cashbackPct   Int?
  aftercare     String?
  returnAfterDays Int?
  priceType     String   @default("fixed")
  imageUrl      String?
  onlineBooking Boolean  @default(true)
  description   String?
  fiscalCode    String?
  issPct        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items          AppointmentItem[]
  products       ServiceProduct[]
  professionals  ProfessionalService[]
  packages       Package[]
  comandaItems   ComandaItem[]
  promotions     PromotionItem[]

  @@index([tenantId])
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

model ServiceProduct {
  id        String  @id @default(cuid())
  serviceId String
  productId String
  quantity  Float
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Client {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  nickname      String?
  phone         String
  landline      String?
  email         String?
  birthDate     DateTime?
  notes         String?
  tags          String    @default("")
  instagram     String?
  facebook      String?
  source        String    @default("balcao")
  cnpj          String?
  cpf           String?
  rg            String?
  imageUrl      String?
  referredById  String?
  referredBy    Client?   @relation("ClientReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     Client[]  @relation("ClientReferral")
  zip           String?
  address       String?
  addressNumber String?
  complement    String?
  district      String?
  city          String?
  state         String?
  defaultDiscountPct Int  @default(0)
  discountTarget     String @default("comanda")
  active        Boolean   @default(true)
  notifications Boolean   @default(true)
  blockAccess   Boolean   @default(false)
  creditCents   Int       @default(0)
  cashbackCents Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments   Appointment[]
  conversations  Conversation[]
  packages       ClientPackage[]
  comandas       Comanda[]
  anamneses      Anamnesis[]
  cashbackMoves  CashbackMovement[]
  fiscalInvoices FiscalInvoice[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
}

model Appointment {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  startAt        DateTime
  endAt          DateTime
  status         String   @default("PENDING")
  notes          String?
  source         String   @default("balcao")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items        AppointmentItem[]
  commissions  Commission[]
  transactions Transaction[]
  stockMoves   StockMovement[]
  comanda      Comanda?

  @@index([tenantId, startAt])
  @@index([professionalId, startAt])
}

model AppointmentItem {
  id             String      @id @default(cuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service     @relation(fields: [serviceId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  startAt        DateTime?
  priceCents     Int
  durationMin    Int
}

model Comanda {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number         Int
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  appointmentId  String?  @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  status         String   @default("OPEN")
  notes          String?
  discountCents  Int      @default(0)
  creditCents    Int      @default(0)
  cashbackCents  Int      @default(0)
  paymentMethod  String?
  occurredAt     DateTime @default(now())
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items        ComandaItem[]
  transactions Transaction[]
  commissions  Commission[]
  stockMoves   StockMovement[]
  invoices     FiscalInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model ComandaItem {
  id             String       @id @default(cuid())
  comandaId      String
  comanda        Comanda      @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  type           String       @default("SERVICE")
  serviceId      String?
  service        Service?     @relation(fields: [serviceId], references: [id])
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  description    String
  quantity       Float        @default(1)
  priceCents     Int
  discountCents  Int          @default(0)
  durationMin    Int          @default(0)
}

model ProductCategory {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0)
  products  Product[]

  @@index([tenantId])
}

model Product {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId             String?
  category               ProductCategory? @relation(fields: [categoryId], references: [id])
  name                   String
  sku                    String?
  barcode                String?
  brand                  String?
  unit                   String   @default("un")
  unitEquals             Float    @default(1)
  costCents              Int      @default(0)
  saleCents              Int      @default(0)
  professionalPriceCents Int      @default(0)
  extraCostCents         Int      @default(0)
  commissionPct          Int?
  cashbackPct            Int?
  returnAfterDays        Int?
  stock                  Float    @default(0)
  minStock               Float    @default(2)
  imageUrl               String?
  notes                  String?
  requestAvailable       Boolean  @default(true)
  active                 Boolean  @default(true)
  ncm                    String?
  cfop                   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  moves        StockMovement[]
  services     ServiceProduct[]
  comandaItems ComandaItem[]
  lots         ProductLot[]
  requests     ProductRequest[]
  promotions   PromotionItem[]

  @@index([tenantId])
}

model ProductLot {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String
  quantity  Float
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tenantId, expiresAt])
}

model ProductRequest {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  quantity       Float
  status         String        @default("PENDING")
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([tenantId, status])
}

model StockMovement {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  type          String
  quantity      Float
  reason        String?
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  comandaId     String?
  comanda       Comanda?     @relation(fields: [comandaId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([tenantId, createdAt])
}

model Commission {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  comandaId      String?
  comanda        Comanda?     @relation(fields: [comandaId], references: [id])
  amountCents    Int
  percent        Int
  status         String       @default("PENDING")
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([tenantId, status])
}

model FinanceAccount {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  details   String   @default("")
  adminOnly Boolean  @default(false)
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentMethods PaymentMethodConfig[]
  transactions   Transaction[]

  @@index([tenantId, sortOrder])
}

model PaymentMethodConfig {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  code           String
  group          String         @default("OTHER")
  feeBps         Int            @default(0)
  accountId      String
  account        FinanceAccount @relation(fields: [accountId], references: [id])
  settlementDays Int            @default(0)
  autoSettle     Boolean        @default(true)
  favorite       Boolean        @default(false)
  active         Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  transactions Transaction[]

  @@index([tenantId, sortOrder])
  @@index([tenantId, code])
}

model FinanceCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  type      String
  slug      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([tenantId, type])
  @@unique([tenantId, slug, type])
}

model Transaction {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           String
  category       String
  amountCents    Int
  feeCents       Int          @default(0)
  netCents       Int          @default(0)
  method         String       @default("PIX")
  account        String       @default("caixa")
  accountId      String?
  financeAccount FinanceAccount? @relation(fields: [accountId], references: [id])
  paymentMethodId String?
  paymentMethodConfig PaymentMethodConfig? @relation(fields: [paymentMethodId], references: [id])
  categoryId     String?
  financeCategory FinanceCategory? @relation(fields: [categoryId], references: [id])
  description    String?
  organizational Boolean      @default(false)
  supplier       String?
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  recurrence     String?
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  comandaId      String?
  comanda        Comanda?     @relation(fields: [comandaId], references: [id])
  competenceAt   DateTime?
  occurredAt     DateTime     @default(now())
  availableAt    DateTime?
  settled        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, accountId])
}

model Package {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  priceCents  Int
  sessions    Int
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  active      Boolean @default(true)

  clients ClientPackage[]
}

model ClientPackage {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id])
  remaining  Int
  purchasedAt DateTime @default(now())
}

model Conversation {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  phone         String
  lastMessageAt DateTime @default(now())
  unread        Int      @default(0)
  messages      Message[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  body           String
  waId           String?
  createdAt      DateTime     @default(now())
}

model Automation {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  trigger   String
  template  String
  active    Boolean @default(true)
}

model CampaignSend {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trigger   String
  clientId  String
  sentOn    String
  createdAt DateTime @default(now())

  @@unique([tenantId, trigger, clientId, sentOn])
  @@index([tenantId, trigger])
}

model AnamnesisForm {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  area        String   @default("geral")
  description String   @default("")
  questions   String   @default("[]")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records Anamnesis[]

  @@unique([tenantId, slug])
  @@index([tenantId, sortOrder])
}

model Anamnesis {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formId         String
  form           AnamnesisForm @relation(fields: [formId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  status         String    @default("DRAFT")
  answers        String    @default("{}")
  notes          String?
  signedName     String?
  signedAt       DateTime?
  occurredAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, occurredAt])
  @@index([clientId])
}

model SupportTicket {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number        Int
  subject       String
  category      String   @default("ajuda")
  priority      String   @default("NORMAL")
  status        String   @default("OPEN")
  createdById   String
  createdBy     User     @relation("TicketAuthor", fields: [createdById], references: [id])
  assignedToId  String?
  assignedTo    User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  lastMessageAt DateTime @default(now())
  unreadSalon   Int      @default(0)
  unreadAdmin   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      SupportMessage[]
  calls         SupportCall[]

  @@unique([tenantId, number])
  @@index([tenantId, lastMessageAt])
  @@index([status])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  side      String
  body      String
  kind      String        @default("TEXT")
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model SupportCall {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId     String?
  ticket       SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  startedById  String
  startedBy    User           @relation("CallStarter", fields: [startedById], references: [id])
  acceptedById String?
  acceptedBy   User?          @relation("CallAcceptor", fields: [acceptedById], references: [id])
  status       String         @default("RINGING")
  startedAt    DateTime       @default(now())
  answeredAt   DateTime?
  endedAt      DateTime?

  @@index([tenantId, status])
  @@index([status])
}

model SupportPresence {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  side       String
  lastSeenAt DateTime @default(now())

  @@index([tenantId])
  @@index([side, lastSeenAt])
}

model PlatformPlan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  priceCents  Int      @default(0)
  interval    String   @default("monthly")
  trialDays   Int      @default(14)
  features    String   @default("[]")
  active      Boolean  @default(true)
  highlighted Boolean  @default(false)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

model CashbackMovement {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type          String
  amountCents   Int
  points        Int
  reason        String?
  comandaId     String?
  createdById   String?
  createdByName String?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([tenantId, clientId, createdAt])
}

model SupplierProduct {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  brand       String?
  sku         String?
  category    String?
  unit        String   @default("un")
  priceCents  Int      @default(0)
  minQty      Float    @default(1)
  stock       Float?
  description String?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  SupplierOrderItem[]
  promoItems  SupplierPromotionItem[]

  @@index([tenantId, active])
}

model SupplierPromotion {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  note          String?
  startsOn      DateTime
  endsOn        DateTime
  weekdays      String   @default("0,1,2,3,4,5,6")
  dealType      String   @default("PERCENT")
  discountValue Int      @default(0)
  buyQty        Int      @default(0)
  payQty        Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         SupplierPromotionItem[]

  @@index([tenantId, active, startsOn, endsOn])
}

model SupplierPromotionItem {
  id           String             @id @default(cuid())
  promotionId  String
  promotion    SupplierPromotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId    String
  product      SupplierProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SupplierOrder {
  id               String   @id @default(cuid())
  salonTenantId    String
  salonTenant      Tenant   @relation("OrdersAsSalon", fields: [salonTenantId], references: [id], onDelete: Cascade)
  supplierTenantId String
  supplierTenant   Tenant   @relation("OrdersAsSupplier", fields: [supplierTenantId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])
  status           String   @default("SUBMITTED")
  fulfillment      String   @default("PICKUP")
  paymentMethod    String   @default("PIX")
  paymentWhen      String   @default("ON_FULFILLMENT")
  notes            String?
  subtotalCents    Int      @default(0)
  deliveryFeeCents Int      @default(0)
  totalCents       Int      @default(0)
  pickupCode       String?
  salonAddress     String?
  salonPhone       String?
  pickupAddress    String?
  fiscalInvoiceId  String?
  receivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  items            SupplierOrderItem[]

  @@unique([pickupCode])
  @@index([salonTenantId, createdAt])
  @@index([supplierTenantId, status])
}

model SupplierOrderItem {
  id        String           @id @default(cuid())
  orderId   String
  order     SupplierOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   SupplierProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  brand     String?
  sku       String?
  unit      String           @default("un")
  quantity  Float
  unitCents Int
  lineCents Int
}
