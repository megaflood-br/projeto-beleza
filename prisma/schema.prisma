generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  tradeName           String?
  document            String?
  phone               String?
  email               String?
  address             String?
  city                String?
  timezone            String   @default("America/Sao_Paulo")
  plan                String   @default("profissional")
  accentColor         String   @default("#9B1D3A")
  openTime            String   @default("08:00")
  closeTime           String   @default("20:00")
  slotMinutes         Int      @default(15)
  openaiApiKey        String?
  evolutionUrl        String?
  evolutionApiKey     String?
  evolutionInstance   String?
  reminderHours       Int      @default(24)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users          User[]
  professionals  Professional[]
  clients        Client[]
  categories     ServiceCategory[]
  services       Service[]
  appointments   Appointment[]
  products       Product[]
  stockMoves     StockMovement[]
  commissions    Commission[]
  transactions   Transaction[]
  packages       Package[]
  clientPackages ClientPackage[]
  conversations  Conversation[]
  automations    Automation[]

  @@index([slug])
}

model User {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String    @unique
  passwordHash   String
  name           String
  role           String
  active         Boolean   @default(true)
  professionalId String?   @unique
  professional   Professional? @relation(fields: [professionalId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
}

model Professional {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  nickname      String?
  color         String   @default("#9B1D3A")
  phone         String?
  specialty     String?
  commissionPct Int      @default(40)
  active        Boolean  @default(true)
  workStart     String   @default("09:00")
  workEnd       String   @default("19:00")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User?
  appointments   Appointment[]
  commissions    Commission[]
  serviceLinks   ProfessionalService[]

  @@index([tenantId])
}

model ServiceCategory {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0)
  services  Service[]

  @@index([tenantId])
}

model Service {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      ServiceCategory? @relation(fields: [categoryId], references: [id])
  name          String
  durationMin   Int
  priceCents    Int
  color         String   @default("#C45B6B")
  commissionPct Int?
  active        Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items          AppointmentItem[]
  products       ServiceProduct[]
  professionals  ProfessionalService[]
  packages       Package[]

  @@index([tenantId])
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

model ServiceProduct {
  id        String  @id @default(cuid())
  serviceId String
  productId String
  quantity  Float
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Client {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String?
  birthDate   DateTime?
  notes       String?
  tags        String    @default("")
  instagram   String?
  source      String    @default("balcao")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appointments   Appointment[]
  conversations  Conversation[]
  packages       ClientPackage[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
}

model Appointment {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  startAt        DateTime
  endAt          DateTime
  status         String   @default("PENDING")
  notes          String?
  source         String   @default("balcao")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items        AppointmentItem[]
  commissions  Commission[]
  transactions Transaction[]
  stockMoves   StockMovement[]

  @@index([tenantId, startAt])
  @@index([professionalId, startAt])
}

model AppointmentItem {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  priceCents    Int
  durationMin   Int
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  unit        String   @default("un")
  costCents   Int      @default(0)
  saleCents   Int      @default(0)
  stock       Float    @default(0)
  minStock    Float    @default(2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  moves    StockMovement[]
  services ServiceProduct[]

  @@index([tenantId])
}

model StockMovement {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  type          String
  quantity      Float
  reason        String?
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([tenantId, createdAt])
}

model Commission {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  appointmentId  String
  appointment    Appointment  @relation(fields: [appointmentId], references: [id])
  amountCents    Int
  percent        Int
  status         String       @default("PENDING")
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([tenantId, status])
}

model Transaction {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          String
  category      String
  amountCents   Int
  method        String       @default("PIX")
  description   String?
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  occurredAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([tenantId, occurredAt])
}

model Package {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  priceCents  Int
  sessions    Int
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  active      Boolean @default(true)

  clients ClientPackage[]
}

model ClientPackage {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id])
  remaining  Int
  purchasedAt DateTime @default(now())
}

model Conversation {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  phone         String
  lastMessageAt DateTime @default(now())
  unread        Int      @default(0)
  messages      Message[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  body           String
  waId           String?
  createdAt      DateTime     @default(now())
}

model Automation {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  trigger   String
  template  String
  active    Boolean @default(true)
}
