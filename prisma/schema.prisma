generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  tradeName           String?
  document            String?
  phone               String?
  email               String?
  address             String?
  city                String?
  timezone            String   @default("America/Sao_Paulo")
  plan                String   @default("profissional")
  accentColor         String   @default("#2563EB")
  openTime            String   @default("08:00")
  closeTime           String   @default("20:00")
  slotMinutes         Int      @default(15)
  openaiApiKey        String?
  evolutionUrl        String?
  evolutionApiKey     String?
  evolutionInstance   String?
  reminderHours       Int      @default(24)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users          User[]
  professionals  Professional[]
  clients        Client[]
  categories     ServiceCategory[]
  services       Service[]
  appointments   Appointment[]
  products           Product[]
  productCategories  ProductCategory[]
  productLots        ProductLot[]
  productRequests    ProductRequest[]
  stockMoves         StockMovement[]
  commissions    Commission[]
  transactions   Transaction[]
  packages       Package[]
  clientPackages ClientPackage[]
  conversations  Conversation[]
  automations    Automation[]
  comandas       Comanda[]
  financeAccounts    FinanceAccount[]
  paymentMethods     PaymentMethodConfig[]
  financeCategories  FinanceCategory[]

  @@index([slug])
}

model User {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String    @unique
  passwordHash   String
  name           String
  role           String
  active         Boolean   @default(true)
  professionalId String?   @unique
  professional   Professional? @relation(fields: [professionalId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
}

model Professional {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  nickname      String?
  color         String   @default("#2563EB")
  phone         String?
  specialty     String?
  commissionPct Int      @default(40)
  active        Boolean  @default(true)
  workStart     String   @default("09:00")
  workEnd       String   @default("19:00")
  imageUrl      String?
  birthDate     DateTime?
  document      String?
  rg            String?
  notes         String?
  zip           String?
  address       String?
  addressNumber String?
  complement    String?
  district      String?
  city          String?
  state         String?
  onlineBooking Boolean  @default(true)
  generateAgenda Boolean @default(true)
  receivesCommission Boolean @default(true)
  isStockist    Boolean  @default(false)
  salonPartner  Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User?
  appointments   Appointment[]
  appointmentItems AppointmentItem[]
  commissions    Commission[]
  serviceLinks   ProfessionalService[]
  comandas         Comanda[]
  comandaItems     ComandaItem[]
  transactions     Transaction[]
  productRequests  ProductRequest[]

  @@index([tenantId])
}

model ServiceCategory {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0)
  services  Service[]

  @@index([tenantId])
}

model Service {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      ServiceCategory? @relation(fields: [categoryId], references: [id])
  name          String
  durationMin   Int
  priceCents    Int
  color         String   @default("#6366F1")
  commissionPct Int?
  active        Boolean  @default(true)
  favorite      Boolean  @default(false)
  extraCostCents Int     @default(0)
  cashbackPct   Int?
  aftercare     String?
  returnAfterDays Int?
  priceType     String   @default("fixed")
  imageUrl      String?
  onlineBooking Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items          AppointmentItem[]
  products       ServiceProduct[]
  professionals  ProfessionalService[]
  packages       Package[]
  comandaItems   ComandaItem[]

  @@index([tenantId])
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

model ServiceProduct {
  id        String  @id @default(cuid())
  serviceId String
  productId String
  quantity  Float
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Client {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  nickname      String?
  phone         String
  landline      String?
  email         String?
  birthDate     DateTime?
  notes         String?
  tags          String    @default("")
  instagram     String?
  facebook      String?
  source        String    @default("balcao")
  cnpj          String?
  cpf           String?
  rg            String?
  imageUrl      String?
  referredById  String?
  referredBy    Client?   @relation("ClientReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     Client[]  @relation("ClientReferral")
  zip           String?
  address       String?
  addressNumber String?
  complement    String?
  district      String?
  city          String?
  state         String?
  defaultDiscountPct Int  @default(0)
  discountTarget     String @default("comanda")
  active        Boolean   @default(true)
  notifications Boolean   @default(true)
  blockAccess   Boolean   @default(false)
  creditCents   Int       @default(0)
  cashbackCents Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments   Appointment[]
  conversations  Conversation[]
  packages       ClientPackage[]
  comandas       Comanda[]

  @@unique([tenantId, phone])
  @@index([tenantId, name])
}

model Appointment {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  startAt        DateTime
  endAt          DateTime
  status         String   @default("PENDING")
  notes          String?
  source         String   @default("balcao")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items        AppointmentItem[]
  commissions  Commission[]
  transactions Transaction[]
  stockMoves   StockMovement[]
  comanda      Comanda?

  @@index([tenantId, startAt])
  @@index([professionalId, startAt])
}

model AppointmentItem {
  id             String      @id @default(cuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service     @relation(fields: [serviceId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  startAt        DateTime?
  priceCents     Int
  durationMin    Int
}

model Comanda {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number         Int
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  appointmentId  String?  @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  status         String   @default("OPEN")
  notes          String?
  discountCents  Int      @default(0)
  creditCents    Int      @default(0)
  cashbackCents  Int      @default(0)
  paymentMethod  String?
  occurredAt     DateTime @default(now())
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items        ComandaItem[]
  transactions Transaction[]
  commissions  Commission[]
  stockMoves   StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model ComandaItem {
  id             String       @id @default(cuid())
  comandaId      String
  comanda        Comanda      @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  type           String       @default("SERVICE")
  serviceId      String?
  service        Service?     @relation(fields: [serviceId], references: [id])
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  description    String
  quantity       Float        @default(1)
  priceCents     Int
  discountCents  Int          @default(0)
  durationMin    Int          @default(0)
}

model ProductCategory {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0)
  products  Product[]

  @@index([tenantId])
}

model Product {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId             String?
  category               ProductCategory? @relation(fields: [categoryId], references: [id])
  name                   String
  sku                    String?
  barcode                String?
  brand                  String?
  unit                   String   @default("un")
  unitEquals             Float    @default(1)
  costCents              Int      @default(0)
  saleCents              Int      @default(0)
  professionalPriceCents Int      @default(0)
  extraCostCents         Int      @default(0)
  commissionPct          Int?
  cashbackPct            Int?
  returnAfterDays        Int?
  stock                  Float    @default(0)
  minStock               Float    @default(2)
  imageUrl               String?
  notes                  String?
  requestAvailable       Boolean  @default(true)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  moves        StockMovement[]
  services     ServiceProduct[]
  comandaItems ComandaItem[]
  lots         ProductLot[]
  requests     ProductRequest[]

  @@index([tenantId])
}

model ProductLot {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String
  quantity  Float
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tenantId, expiresAt])
}

model ProductRequest {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  quantity       Float
  status         String        @default("PENDING")
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([tenantId, status])
}

model StockMovement {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  type          String
  quantity      Float
  reason        String?
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  comandaId     String?
  comanda       Comanda?     @relation(fields: [comandaId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([tenantId, createdAt])
}

model Commission {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  comandaId      String?
  comanda        Comanda?     @relation(fields: [comandaId], references: [id])
  amountCents    Int
  percent        Int
  status         String       @default("PENDING")
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([tenantId, status])
}

model FinanceAccount {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  details   String   @default("")
  adminOnly Boolean  @default(false)
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentMethods PaymentMethodConfig[]
  transactions   Transaction[]

  @@index([tenantId, sortOrder])
}

model PaymentMethodConfig {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  code           String
  group          String         @default("OTHER")
  feeBps         Int            @default(0)
  accountId      String
  account        FinanceAccount @relation(fields: [accountId], references: [id])
  settlementDays Int            @default(0)
  autoSettle     Boolean        @default(true)
  favorite       Boolean        @default(false)
  active         Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  transactions Transaction[]

  @@index([tenantId, sortOrder])
  @@index([tenantId, code])
}

model FinanceCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  type      String
  slug      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([tenantId, type])
  @@unique([tenantId, slug, type])
}

model Transaction {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           String
  category       String
  amountCents    Int
  feeCents       Int          @default(0)
  netCents       Int          @default(0)
  method         String       @default("PIX")
  account        String       @default("caixa")
  accountId      String?
  financeAccount FinanceAccount? @relation(fields: [accountId], references: [id])
  paymentMethodId String?
  paymentMethodConfig PaymentMethodConfig? @relation(fields: [paymentMethodId], references: [id])
  categoryId     String?
  financeCategory FinanceCategory? @relation(fields: [categoryId], references: [id])
  description    String?
  organizational Boolean      @default(false)
  supplier       String?
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  recurrence     String?
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  comandaId      String?
  comanda        Comanda?     @relation(fields: [comandaId], references: [id])
  competenceAt   DateTime?
  occurredAt     DateTime     @default(now())
  availableAt    DateTime?
  settled        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, accountId])
}

model Package {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  priceCents  Int
  sessions    Int
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  active      Boolean @default(true)

  clients ClientPackage[]
}

model ClientPackage {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id])
  remaining  Int
  purchasedAt DateTime @default(now())
}

model Conversation {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  phone         String
  lastMessageAt DateTime @default(now())
  unread        Int      @default(0)
  messages      Message[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  body           String
  waId           String?
  createdAt      DateTime     @default(now())
}

model Automation {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  trigger   String
  template  String
  active    Boolean @default(true)
}
